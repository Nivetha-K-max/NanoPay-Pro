# ── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api

# ── Backend ─────────────────────────────────────────────────────────────────
API_PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nanopay
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nanopay
DB_USERNAME=postgres
DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
# Minimum 64 bytes (512 bits) for HS512
JWT_SECRET=change-me-to-a-64-byte-base64-secret
JWT_EXPIRES_IN=7d

# ── Encryption (AES-256-GCM for PII fields) ────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── HTTPS (production only) ────────────────────────────────────────────────
HTTPS_ENFORCE=false
SSL_ENABLED=false
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── OAuth2 ──────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Monitoring ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=