# Development environment — safe to commit with placeholder values.
# NEVER commit .env.prod with real credentials.

APP_PROFILE=dev

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nanopay_dev
DB_USERNAME=nanopay
DB_PASSWORD=nanopay_dev_pass
DB_ROOT_PASSWORD=root_dev_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT — 64-byte (512-bit) base64-encoded key for HS512
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64

# Mail (use Mailtrap or similar in dev)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_user
MAIL_PASSWORD=your_mailtrap_pass

# OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Monitoring
GRAFANA_PASSWORD=admin
