# NanoPay Pro .env.prod Template

# ⚠️  PRODUCTION ENVIRONMENT VARIABLES
# This file is a TEMPLATE. Create .env.prod separately with REAL values.
# NEVER commit .env.prod to version control.

APP_PROFILE=prod

# Database — use managed DB service (RDS, Cloud SQL, etc.)
DB_HOST=prod-db-instance.c5xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=nanopay_prod
DB_USERNAME=nanopay_prod_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_FROM_SECRETS_MANAGER

# Redis — use managed cache (ElastiCache, Redis Cloud, etc.)
REDIS_HOST=prod-redis.xxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_FROM_SECRETS_MANAGER

# Kafka — use managed service (MSK, Confluent Cloud, etc.)
KAFKA_BOOTSTRAP_SERVERS=kafka-1.prod:9092,kafka-2.prod:9092,kafka-3.prod:9092

# JWT Secret — 64-byte base64 key for HS512
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_GENERATED_KEY_FROM_SECRETS_MANAGER

# Email — use SendGrid, AWS SES, or similar transactional service
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY

# OAuth2 — from Google Cloud Console
GOOGLE_CLIENT_ID=REPLACE_WITH_PRODUCTION_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_CLIENT_SECRET

# CORS — your production domain
CORS_ALLOWED_ORIGINS=https://app.nanopay.com,https://www.nanopay.com

# Monitoring
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
